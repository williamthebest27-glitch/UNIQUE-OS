# ─────────────────────────────────────────────────────────────
# Unique OS — variabili d'ambiente
# Copiare in .env.local e compilare. NON committare mai .env.local
# ─────────────────────────────────────────────────────────────

# Supabase (progetto in regione UE — obbligatorio per dati sanitari)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave service-role: SOLO server-side, mai esposta al browser.
# Bypassa la Row Level Security: usarla unicamente in route handler
# e job di back-office.
SUPABASE_SERVICE_ROLE_KEY=

# Unique Brain — layer AI
# Il Brain risponde con il motore proprietario di Unique: nessuna chiave,
# nessuna rete, nessun dato che esce. Vale per la chat della direzione.
#
# # UNIQUE_BRAIN=ollama usa un modello aperto sul tuo server: conversazione
# libera, referti scansionati e copy finito senza che niente esca dalla
# clinica. Serve Ollama acceso e un modello scaricato (ollama pull).
UNIQUE_BRAIN=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14banthropic accende il modello linguistico al suo posto, per la
# conversazione libera. Si attiva di proposito: una chiave dimenticata qui
# non e' un consenso a mandare fuori i numeri dell'azienda.
UNIQUE_BRAIN=

# Serve al modello linguistico e ai tre lavori di lingua che un motore
# deterministico non fa: leggere un referto, il copilot clinico, il Content Brain.
ANTHROPIC_API_KEY=

# Applicazione
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Portale del gestore dei pagamenti, dove il paziente aggiorna la carta.
# Il numero della carta non passa mai da Unique OS.
NEXT_PUBLIC_BILLING_PORTAL_URL=

# Segreto condiviso con il gestionale che invia prenotazioni e disponibilità
# a POST /api/integrazioni/prenotazioni. Generane uno lungo e casuale.
UNIQUE_SYNC_TOKEN=
